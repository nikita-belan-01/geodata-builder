# Router connection
NETCRAZE_ROUTER=192.168.1.1
NETCRAZE_PORT=22
NETCRAZE_USER=user
NETCRAZE_PASSWORD=password
NETCRAZE_KEYCHAIN_SERVICE=netcraze-full-updater
NETCRAZE_ROUTE_INTERFACE=PPPoE0
NETCRAZE_CONNECT_TIMEOUT=10s
NETCRAZE_COMMAND_TIMEOUT=30s

# Lists
NETCRAZE_SOURCE_URL=https://github.com/v2fly/domain-list-community/archive/refs/heads/master.zip
NETCRAZE_LIST=full
NETCRAZE_LINES_PER_FILE=300
NETCRAZE_USE_EXISTING=false
NETCRAZE_OUTPUT_DIR=netcraze_output
NETCRAZE_ARCHIVE=netcraze_output.zip

# Logging (log/slog)
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DIR=logs
